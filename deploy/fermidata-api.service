[Unit]
Description=fermidata API (Express + Prisma)
Documentation=file:///var/www/html/fermidata/readme.md
After=network-online.target mysql.service
Wants=network-online.target
Requires=mysql.service

[Service]
Type=simple
User=mdxuser
Group=mdxuser
WorkingDirectory=/var/www/html/fermidata/api
Environment=NODE_ENV=production
EnvironmentFile=/var/www/html/fermidata/api/.env
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5
SyslogIdentifier=fermidata-api

# 最低限の保護
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/www/html/fermidata/api

[Install]
WantedBy=multi-user.target
